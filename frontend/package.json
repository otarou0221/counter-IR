{
  "name": "cardboard-counter-v2-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:web-assets": "node scripts/sync-static-assets.mjs",
    "predev": "npm run prepare:web-assets",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run prepare:web-assets",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "konva": "10.3.2",
    "plotly.js-dist-min": "2.35.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-konva": "19.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^4.1.10"
  }
}
